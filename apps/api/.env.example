# apps/api 환경변수 예시. 실제 값은 .env 에 넣고 절대 커밋하지 않는다 (CLAUDE.md 절대 규칙).
# 올바로/PG 는 반드시 샌드박스·테스트 모드로 먼저 검증한 뒤 운영 전환한다.

# 서버
PORT=4000
NODE_ENV=development
# CORS 허용 출처(콤마 구분). 운영(NODE_ENV=production)에서는 반드시 지정해야 기동된다.
# 미설정 시 개발 편의로 전체 허용.
CORS_ORIGINS=

# PostgreSQL — 미설정 시 JSON 파일 저장(.data)로 폴백(운영 부적합, 재시작 시 세션·OTP 소실).
DATABASE_URL=postgresql://user:password@localhost:5432/dimollink

# Redis — 설정 시 세션·레이트리밋을 인스턴스 간 공유(다중 인스턴스). 미설정 시 인메모리(단일 인스턴스).
REDIS_URL=

# 인증/세션/OTP
# 세션 토큰 유효기간(일)
SESSION_TTL_DAYS=30
# OTP 코드 유효시간(초)·재발송 쿨다운(초)·최대 검증 시도 횟수
OTP_TTL_SEC=180
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_ATTEMPTS=5
# 개발/테스트용 마스터 인증코드 — 운영(NODE_ENV=production)에서는 자동으로 무시된다.
OTP_DEV_MASTER_CODE=123456

# ── 테스트/스테이징 배포 전용 (운영에서는 절대 켜지 말 것) ──
# 운영 모드(Vercel 등 NODE_ENV=production)에서도 마스터 OTP 코드를 허용(테스트 로그인용).
ALLOW_TEST_OTP=false
# 기동 시 역할별 테스트 계정을 없으면 생성(멱등).
SEED_TEST_ACCOUNTS=false

# 백오피스 관리자 API 토큰 — 운영에서는 반드시 지정해야 기동된다.
ADMIN_TOKEN=

# SMS 발송(OTP) — 미설정 시 콘솔 출력으로 폴백(개발). REST 발송 API 기준.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT_MS=5000

# 주소 → 좌표 지오코딩(거리 매칭용) — kakao | none. 미설정 시 좌표 없이 진행.
GEOCODE_PROVIDER=none
KAKAO_REST_API_KEY=
GEOCODE_TIMEOUT_MS=5000

# 올바로(Allbaro) API — 샌드박스 값으로 시작
ALLBARO_API_BASE_URL=https://sandbox.allbaro.example
ALLBARO_API_KEY=
ALLBARO_CERT_PATH=
# 연동 환경: sandbox | production (기본 sandbox). 샌드박스 검증 완료 전엔 production 금지.
ALLBARO_ENV=sandbox
# production 호출을 명시적으로 허용할 때만 true. 미설정 시 운영 호출은 차단된다.
ALLBARO_ALLOW_PRODUCTION=false
# 올바로 응답 타임아웃(ms)
ALLBARO_TIMEOUT_MS=10000

# 현장 사진 스토리지 — AWS S3 또는 S3 호환 서비스(NCP Object Storage, MinIO 등)
# 버킷은 비공개(private)로 만들고, 업로드/조회 모두 presigned URL 로만 접근한다.
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
# S3 호환 서비스 사용 시에만 설정 (예: https://kr.object.ncloudstorage.com)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# MinIO 등 path-style 전용 스토리지면 true
STORAGE_FORCE_PATH_STYLE=false
# presigned URL 유효시간(초)
STORAGE_UPLOAD_URL_TTL_SEC=300
STORAGE_VIEW_URL_TTL_SEC=600

# 결제 PG(포트원 PortOne) — 반드시 테스트 모드 키로 먼저 검증한 뒤 운영 전환
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_STORE_ID=
# 연동 환경: test | live (기본 test). 테스트 검증 완료 전엔 live 금지.
PORTONE_ENV=test
# live(실거래) 호출을 명시적으로 허용할 때만 true. 미설정 시 실거래 호출은 차단된다.
PORTONE_ALLOW_LIVE=false
PORTONE_TIMEOUT_MS=10000
