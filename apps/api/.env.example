# apps/api 환경변수 예시. 실제 값은 .env 에 넣고 절대 커밋하지 않는다 (CLAUDE.md 절대 규칙).
# 올바로/PG 는 반드시 샌드박스·테스트 모드로 먼저 검증한 뒤 운영 전환한다.

# 서버
PORT=4000
NODE_ENV=development
# CORS 허용 출처(콤마 구분). 운영(NODE_ENV=production)에서는 반드시 지정해야 기동된다.
# 미설정 시 개발 편의로 전체 허용.
CORS_ORIGINS=

# PostgreSQL — 미설정 시 JSON 파일 저장(.data)로 폴백(운영 부적합, 재시작 시 세션·OTP 소실).
DATABASE_URL=postgresql://user:password@localhost:5432/dimollink

# Redis(TCP) — 설정 시 세션·레이트리밋을 인스턴스 간 공유(다중 인스턴스). 미설정 시 인메모리(단일 인스턴스).
REDIS_URL=

# Upstash Redis(REST) — 서버리스(Vercel)에서 TCP 대신 사용. 마켓플레이스 연동 시 자동 주입.
# REDIS_URL 미설정 + 아래 둘 다 설정 시 세션·OTP·레이트리밋을 인스턴스 간 공유한다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 인증/세션/OTP
# 세션 토큰 유효기간(일)
SESSION_TTL_DAYS=30
# 무상태(서명) 세션 시크릿 — 설정 시 Redis 없이도 서버리스에서 세션 유지. 고정·강한 랜덤값.
SESSION_SECRET=
# OTP 코드 유효시간(초)·재발송 쿨다운(초)·최대 검증 시도 횟수
OTP_TTL_SEC=180
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_ATTEMPTS=5
# 개발/테스트용 마스터 인증코드 — 운영(NODE_ENV=production)에서는 자동으로 무시된다.
OTP_DEV_MASTER_CODE=123456

# ── 테스트/스테이징 배포 전용 (운영에서는 절대 켜지 말 것) ──
# 운영 모드(Vercel 등 NODE_ENV=production)에서도 마스터 OTP 코드를 허용(테스트 로그인용).
ALLOW_TEST_OTP=false
# 기동 시 역할별 테스트 계정을 없으면 생성(멱등).
SEED_TEST_ACCOUNTS=false

# 백오피스 관리자 API 토큰 — 운영에서는 반드시 지정해야 기동된다.
ADMIN_TOKEN=

# SMS 발송(OTP) — 미설정 시 콘솔 출력으로 폴백(개발).
# 발송 공급자: auto(기본, 설정된 것 자동 선택) | solapi | http | console
SMS_PROVIDER=auto
# 발신번호 — Solapi/범용 REST 공통. 공급자 콘솔에 사전 등록·인증한 번호여야 한다.
SMS_SENDER=
SMS_TIMEOUT_MS=5000
# Solapi(구 CoolSMS) — 권장. 콘솔 > 개발/API Key 에서 발급. Secret 은 재확인 불가하니 발급 시 보관.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 범용 REST 발송 API(Bearer 인증) — Solapi 대신 다른 문자사를 쓸 때만.
SMS_API_URL=
SMS_API_KEY=

# 주소 → 좌표 지오코딩(거리 매칭용) — kakao | none. 미설정 시 좌표 없이 진행.
GEOCODE_PROVIDER=none
KAKAO_REST_API_KEY=
GEOCODE_TIMEOUT_MS=5000

# ── 소셜 로그인(카카오/구글/네이버 OAuth) ──
# 각 공급자 콘솔에서 앱 등록 후 client_id/secret 발급. 자격증명이 없으면 해당 로그인은 503 으로 비활성.
# 콜백 베이스(공개 API 주소). 공급자 콘솔에 등록하는 redirect_uri 는 {base}/api/auth/oauth/{provider}/callback
OAUTH_REDIRECT_BASE=
# 콜백 후 앱 복귀 딥링크(예: dimollink://auth). 미설정 시 콜백이 JSON 반환(웹/로컬 테스트).
OAUTH_APP_REDIRECT=
# state·가입티켓 서명 시크릿(강한 랜덤). 미설정 시 SESSION_SECRET 재사용. 둘 다 없으면 소셜 로그인 비활성.
OAUTH_STATE_SECRET=
# 카카오: client_id 는 앱 REST API 키(카카오디벨로퍼스). client_secret 은 콘솔에서 활성화 권장.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 구글: Google Cloud Console → OAuth 2.0 클라이언트(웹). 승인 리디렉션 URI 등록 필요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 네이버: 네이버 개발자센터 → 애플리케이션 등록(로그인). Callback URL 등록 필요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 올바로(Allbaro) API — 샌드박스 값으로 시작
ALLBARO_API_BASE_URL=https://sandbox.allbaro.example
ALLBARO_API_KEY=
ALLBARO_CERT_PATH=
# 연동 환경: sandbox | production (기본 sandbox). 샌드박스 검증 완료 전엔 production 금지.
ALLBARO_ENV=sandbox
# production 호출을 명시적으로 허용할 때만 true. 미설정 시 운영 호출은 차단된다.
ALLBARO_ALLOW_PRODUCTION=false
# 올바로 응답 타임아웃(ms)
ALLBARO_TIMEOUT_MS=10000

# 현장 사진 스토리지 — AWS S3 또는 S3 호환 서비스(NCP Object Storage, MinIO 등)
# 버킷은 비공개(private)로 만들고, 업로드/조회 모두 presigned URL 로만 접근한다.
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
# S3 호환 서비스 사용 시에만 설정 (예: https://kr.object.ncloudstorage.com)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# MinIO 등 path-style 전용 스토리지면 true
STORAGE_FORCE_PATH_STYLE=false
# presigned URL 유효시간(초)
STORAGE_UPLOAD_URL_TTL_SEC=300
STORAGE_VIEW_URL_TTL_SEC=600

# DB 백업 보관소(S3 호환) — 매일 KST 04:00 자동 백업. 미설정이면 백업이 꺼진다.
# ⚠️ 현장 사진 버킷과 **반드시 분리**한다. 덤프에는 전 회원 PII 가 평문으로 들어 있어서,
#    앱이 쓰는 사진 버킷 키가 새면 백업까지 새는 구조가 되면 안 된다.
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=auto
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_FORCE_PATH_STYLE=false
# 보관 일수(기본 30). 지난 것은 지우되 최신 1개는 항상 남긴다.
BACKUP_RETENTION_DAYS=30
# 백업을 뜨는 시각(KST, 기본 4시)
BACKUP_HOUR_KST=4

# 현장 사진 AI 분석(Claude 비전) — 미설정 시 목(mock) 분석으로 폴백(키·비용 없이 동작).
# 사진 1장당 소액 과금. 실제 분석을 켜려면 Anthropic API 키를 넣는다.
ANTHROPIC_API_KEY=
# 비전 분석 모델(기본: 비용 대비 성능이 좋은 Sonnet)
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_MS=30000

# 결제 PG(포트원 PortOne) — 반드시 테스트 모드 키로 먼저 검증한 뒤 운영 전환
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_STORE_ID=
# 결제창 채널(포트원 콘솔에서 PG사별 발급). 현재 PG 는 **토스페이먼츠**.
# 앱이 GET /api/payments/config 로 받아 쓴다 — 채널을 바꿔도 앱 재빌드가 필요 없다.
PORTONE_CHANNEL_KEY=
# 연동 환경: test | live (기본 test). 테스트 검증 완료 전엔 live 금지.
PORTONE_ENV=test
# live(실거래) 호출을 명시적으로 허용할 때만 true. 미설정 시 실거래 호출은 차단된다.
PORTONE_ALLOW_LIVE=false
PORTONE_TIMEOUT_MS=10000

# ── 공공데이터포털(data.go.kr) ────────────────────────────────────────────────
# 국토교통부_건축HUB 건축물대장정보 서비스(1613000) 인증키.
# 디몰비전이 현장 주소로 건물 정보(구조·용도·층수·연면적·대지면적·용도지역·높이·
# 승강기·사용승인일)를 촬영 전에 확인하는 데 쓴다.
# 발급: data.go.kr → '건축물대장' 검색 → 오픈API → 활용신청(개발계정 자동승인)
# ⚠️ 이 키만으로는 동작하지 않는다. 대장 조회는 주소를 법정동코드+지번으로 바꾼 뒤
#    호출하므로 KAKAO_REST_API_KEY 가 반드시 함께 있어야 한다.
VISION_BLDG_LEDGER_KEY=
BUILDING_REGISTRY_TIMEOUT_MS=10000

# ── 비전 AI (현장 사진 분석) ─────────────────────────────────────────────────
# 우선순위: Groq(무료·카드불필요) > Gemini(무료티어) > Claude(유료) > 목(MOCK).
# 전부 비어 있으면 목 분석 결과가 나가고 화면에 '참고(목) 분석'으로 표시된다.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
VISION_TIMEOUT_MS=30000

# 포트원 웹훅 서명 검증 시크릿(가상계좌 입금 완료 수신 검증).
PORTONE_WEBHOOK_SECRET=

# 기능 플래그 — 인테리어 밀봉 역경매(로드맵 편입 전까지 off).
FEATURE_INTERIOR=false
