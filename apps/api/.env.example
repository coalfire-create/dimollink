# apps/api 환경변수 예시. 실제 값은 .env 에 넣고 절대 커밋하지 않는다 (CLAUDE.md 절대 규칙).
# 올바로/PG 는 반드시 샌드박스·테스트 모드로 먼저 검증한 뒤 운영 전환한다.

# 서버
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dimollink

# 올바로(Allbaro) API — 샌드박스 값으로 시작
ALLBARO_API_BASE_URL=https://sandbox.allbaro.example
ALLBARO_API_KEY=
ALLBARO_CERT_PATH=
# 연동 환경: sandbox | production (기본 sandbox). 샌드박스 검증 완료 전엔 production 금지.
ALLBARO_ENV=sandbox
# production 호출을 명시적으로 허용할 때만 true. 미설정 시 운영 호출은 차단된다.
ALLBARO_ALLOW_PRODUCTION=false
# 올바로 응답 타임아웃(ms)
ALLBARO_TIMEOUT_MS=10000

# 현장 사진 스토리지 — AWS S3 또는 S3 호환 서비스(NCP Object Storage, MinIO 등)
# 버킷은 비공개(private)로 만들고, 업로드/조회 모두 presigned URL 로만 접근한다.
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
# S3 호환 서비스 사용 시에만 설정 (예: https://kr.object.ncloudstorage.com)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# MinIO 등 path-style 전용 스토리지면 true
STORAGE_FORCE_PATH_STYLE=false
# presigned URL 유효시간(초)
STORAGE_UPLOAD_URL_TTL_SEC=300
STORAGE_VIEW_URL_TTL_SEC=600

# 결제 PG(포트원 PortOne) — 반드시 테스트 모드 키로 먼저 검증한 뒤 운영 전환
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_STORE_ID=
# 연동 환경: test | live (기본 test). 테스트 검증 완료 전엔 live 금지.
PORTONE_ENV=test
# live(실거래) 호출을 명시적으로 허용할 때만 true. 미설정 시 실거래 호출은 차단된다.
PORTONE_ALLOW_LIVE=false
PORTONE_TIMEOUT_MS=10000
