# 디몰비전 AI 서버 환경변수 (기획서 §7.2 — 실제 키는 .env 로만, 커밋 금지)
# 접두어 VISION_ 로 app/config.py 의 Settings 에 매핑된다.

# 인증 — Edge Function 전용 API 키 / 관리자 키 (운영에서는 강한 난수로 교체)
VISION_API_KEY=dev-edge-key
VISION_ADMIN_KEY=dev-admin-key
# Supabase 콜백 검증용 시크릿 (비우면 콜백에 서명 헤더 미포함)
VISION_CALLBACK_SECRET=

# 모델 식별 — result.model_version = base+adapter (§5.1)
VISION_MODEL_BASE=Qwen/Qwen3-VL-8B-Instruct
VISION_MODEL_ADAPTER_HASH=mock

# 추론 파이프라인: mock(로컬/CI) | vllm(GPU)
VISION_PIPELINE=mock
# vLLM OpenAI 호환 엔드포인트(pipeline=vllm 일 때)
VISION_VLLM_BASE_URL=http://localhost:8000/v1
VISION_VLLM_API_KEY=
# 학습된 LoRA 어댑터 이름(vLLM --enable-lora 서빙 시 채팅 요청 model 로 사용).
# 예: recognition-ground-v1 (지상 자재 인식기). 비우면 base 모델 호출.
VISION_VLLM_LORA=

# RAG 검색기: memory(로컬/CI) | pg(pgvector). 임베더: mock | bge-m3.
VISION_KB_BACKEND=memory
VISION_KB_EMBEDDER=mock
# Postgres DSN(pg 백엔드/적재용). 비우면 memory 폴백.
VISION_DB_URL=

# 잡 저장소 SQLite 경로
VISION_DB_PATH=vision_jobs.db

# 재시도 상한 / 잡 타임아웃(초) / 사진 장수 상한
VISION_MAX_RETRIES=2
VISION_JOB_TIMEOUT_SECONDS=180
VISION_MAX_PHOTOS=10

VISION_ENVIRONMENT=local

# --- 전국 학습데이터 수집(scripts/harvest_korea.py, 실행 시에만 필요) ---
# 국토교통부 건축HUB 건축물대장 OpenAPI 인증키 (data.go.kr/data/15134735)
VISION_BLDG_LEDGER_KEY=
# 국토지리정보원 VWorld 오픈API 인증키 (vworld.kr — 인증키 발급, 즉시)
VISION_VWORLD_KEY=
# VWorld 인증키 발급 시 등록한 도메인 URL(referer 검사 대응). 서버수집은 등록 URL 로.
VISION_VWORLD_REFERER=http://localhost
