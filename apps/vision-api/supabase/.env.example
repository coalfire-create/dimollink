# 디몰비전 Edge Functions 시크릿 (기획서 §7.2 — 키는 Supabase 시크릿으로만).
# 실제 값을 채운 supabase/.env 를 만들고: supabase secrets set --env-file supabase/.env
# (supabase/.env 는 .gitignore 로 커밋 금지. 이 .env.example 만 추적한다.)
#
# 주의: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는
# Supabase 런타임이 Edge Functions 에 자동 주입하므로 여기서 설정하지 않는다.

# AI 서버(vision-api, GPU) 접속 — Edge 가 POST /v1/jobs 트리거에 사용.
VISION_API_URL=https://<vision-api-host>/v1
VISION_API_KEY=<vision-api 와 공유하는 API 키>

# 콜백 검증 시크릿 — vision-api 가 analysis-callback 호출 시 서명. vision-api 와 동일 값.
VISION_CALLBACK_SECRET=<무작위 32바이트 hex>

# 선택(기본값 있음)
VISION_PHOTO_BUCKET=vision-site-photos
VISION_SIGNED_URL_TTL=600
VISION_MAX_PHOTOS=40
